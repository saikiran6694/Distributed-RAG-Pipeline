# ─────────────────────────────────────────────────────────────────
#  .env.example — copy to .env and fill in real values
#  Never commit .env to git
# ─────────────────────────────────────────────────────────────────

SERVICE_NAME=rag-ingestion
ENVIRONMENT=local
LOG_LEVEL=INFO

# Kafka (matches docker-compose defaults)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=rag-ingestion-workers
KAFKA_MAX_RETRIES=3

# PostgreSQL (matches docker-compose defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_registry
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_secret

# Qdrant (matches docker-compose defaults)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=rag_chunks

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Embedding backend: 'openai' | 'huggingface' | 'ollama'
EMBED_BACKEND=huggingface
EMBED_BATCH_SIZE=32

# OpenAI (only needed if EMBED_BACKEND=openai)
# OPENAI_API_KEY=sk-...
OPENAI_EMBED_MODEL=text-embedding-3-small

# HuggingFace local model (used by default — no API key needed)
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_DEVICE=cpu

# Ollama (only needed if EMBED_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Chunking defaults
CHUNK_FIXED_SIZE_TOKENS=512
CHUNK_FIXED_OVERLAP_TOKENS=50
CHUNK_SEMANTIC_THRESHOLD=0.75
CHUNK_HIER_PARENT_TOKENS=1500
CHUNK_HIER_CHILD_TOKENS=300

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ENABLE_TRACING=true
ENABLE_METRICS=true

# Reconciliation
RECONCILIATION_INTERVAL_SECONDS=300
RECONCILIATION_STALE_MINUTES=10
